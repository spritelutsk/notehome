[Unit]
Description=SpriteNote web app (Node.js + Express)
After=network-online.target mariadb.service
Wants=network-online.target
Requires=mariadb.service

[Service]
Type=simple
User=sprite_lutsk1
WorkingDirectory=/home/sprite_lutsk1/app
ExecStart=/opt/nodejs/bin/node server/index.js
Restart=always
RestartSec=3
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
