#!/usr/sbin/nft -f
#
# Журнал TCP-подключений к 80 и 443 на уровне пакетов.
#
# nginx видит только тех, кто дошёл до HTTP-запроса. Порт-скан, который шлёт SYN и уходит,
# оборванное на первом пакете рукопожатие TLS и скан «странными флагами» (nmap -sF/-sX/-sN)
# в access.log не попадают вообще — их видно только здесь.
#
# Таблица ничего не фильтрует: policy accept, единственное действие — log. Она заведена
# отдельно от table ip filter, где живут цепочки Tailscale (ими управляет сам tailscaled
# через iptables-nft, и трогать их нельзя). Два независимых семейства не конфликтуют.
#
# Приоритет ниже filter: логируем раньше, чем Tailscale успеет что-нибудь отбросить,
# иначе отброшенное не попало бы в журнал.

# destroy вместо delete: не ругается, когда таблицы ещё нет. Нужен, чтобы файл можно было
# перечитывать сколько угодно раз, не накапливая дубли правил.
destroy table inet log_web

table inet log_web {
    chain input {
        type filter hook input priority filter - 10; policy accept;

        # Только начало соединения. Без ct state new в журнал шла бы каждая пачка пакетов
        # уже открытой сессии, и файл рос бы на пустом месте.
        #
        # limit — защита SD-карты. Под заливкой скана без него журнал забьёт раздел за минуты;
        # 60 записей в минуту достаточно, чтобы факт скана был виден, а всплеск переживается
        # запасом burst. Отброшенное сверх лимита не логируется, но и не блокируется.
        tcp dport { 80, 443 } ct state new \
            limit rate 60/minute burst 30 packets \
            log prefix "WEB-CONN " level info

        # Пакет не на установленное соединение и не начало нового: ACK-скан, FIN/NULL/Xmas.
        # Отдельный префикс, чтобы в журнале это не путалось с обычными подключениями.
        tcp dport { 80, 443 } ct state invalid \
            limit rate 20/minute burst 10 packets \
            log prefix "WEB-ODD " level info
    }
}
